/-- The component table: the concatenation of the chunks.  There
is deliberately only ONE table — an equality theorem between two
spellings would force the kernel to compare 392 literal STATES
(each with function fields), which is what exhausted memory.
GENERATED — do not edit by hand. -/
def distTab : List (State × ((List (List Card) × Nat) × Nat)) :=
  c0 ++ c1 ++ c2 ++ c3 ++ c4 ++ c5 ++ c6 ++ c7 ++ c8 ++ c9 ++ c10 ++ c11 ++ c12 ++ c13 ++ c14 ++ c15 ++ c16 ++ c17 ++ c18 ++ c19 ++ c20 ++ c21 ++ c22 ++ c23 ++ c24 ++ c25 ++ c26 ++ c27 ++ c28 ++ c29 ++ c30 ++ c31 ++ c32 ++ c33 ++ c34 ++ c35 ++ c36 ++ c37 ++ c38 ++ c39
/-- The distance read: the first table entry whose stored key matches the
state's key, else `999`. -/
def dlookupD (k : List (List Card) × Nat) :
    List (State × ((List (List Card) × Nat) × Nat)) → Nat
  | [] => 999
  | (s, (sk, d)) :: t => if sk = k then d else dlookupD k t

/-- The distance of a state (`999` = outside the component). -/
def D (st : State) : Nat := dlookupD (skey st) distTab

/-- One state's per-move certificate: a reversible candidate either does not
fire, or lands in the table with the distance dropping by at most one. -/
def moveOK (st : State) (m : Move) : Bool :=
  if reversibleOf st m then
    match st.step m with
    | none => true
    | some t =>
        let dt := D t
        decide (dt < 999) && decide (D st ≤ dt + 1)
  else true

/-- One state's certificate. -/
def certOK (st : State) : Bool := (allMoves st).all (moveOK st)

