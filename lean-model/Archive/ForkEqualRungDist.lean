/-- **EVERY COMPONENT STATE IS CERTIFIED.**  Assembled from the chunk decides
by pure list/Bool rewriting (the kernel check is trivial); each chunk is a
small bounded computation.  The `Bool.true_and`/`Bool.and_true` lemmas are
what collapse the `true && … && true` chain the append-rewrites leave
behind — without them the assembly's goal is left unsolved. -/
theorem cert_all : (distTab.map (fun p => p.1)).all certOK = true := by
  simp only [distTab, List.map_append, List.all_append, cert_c0, cert_c1, cert_c2, cert_c3, cert_c4, cert_c5, cert_c6, cert_c7, cert_c8, cert_c9, cert_c10, cert_c11, cert_c12, cert_c13, cert_c14, cert_c15, cert_c16, cert_c17, cert_c18, cert_c19, cert_c20, cert_c21, cert_c22, cert_c23, cert_c24, cert_c25, cert_c26, cert_c27, cert_c28, cert_c29, cert_c30, cert_c31, cert_c32, cert_c33, cert_c34, cert_c35, cert_c36, cert_c37, cert_c38, cert_c39, Bool.true_and, Bool.and_true]

/-- **THE PER-MOVE BOUND, EXTRACTED.** -/
theorem cert_step {st t : State} {m : Move}
    (hok : certOK st = true)
    (hrev : reversibleOf st m = true) (hst : st.step m = some t) :
    D t < 999 ∧ D st ≤ D t + 1 := by
  have hm : m ∈ allMoves st := step_mem_allMoves hrev hst
  have h1 := List.all_eq_true.mp hok m hm
  unfold moveOK at h1
  simp only [hrev, if_true, hst, Bool.and_eq_true] at h1
  exact ⟨of_decide_eq_true h1.1, of_decide_eq_true h1.2⟩

/-! ## §2. The lookup lemmas -/

theorem dlookupD_lt {k : List (List Card) × Nat} :
    ∀ (l : List (State × ((List (List Card) × Nat) × Nat))), dlookupD k l < 999 →
      ∃ p ∈ l, p.2.1 = k
  | [], h => by simp [dlookupD] at h
  | (s, (sk, d)) :: t, h => by
      simp only [dlookupD] at h
      by_cases hk : sk = k
      · exact ⟨_, List.mem_cons_self .., hk⟩
      · rw [if_neg hk] at h
        obtain ⟨p, hp, hkey⟩ := dlookupD_lt t h
        exact ⟨p, List.mem_cons_of_mem _ hp, hkey⟩

/-- **Tabled**: the state's key is a stored key of the table. -/
def Tabled (st : State) : Prop := ∃ p ∈ distTab, p.2.1 = skey st

theorem tabled_of_D_lt {st : State} (h : D st < 999) : Tabled st := by
  obtain ⟨p, hp, hkey⟩ := dlookupD_lt distTab h
  exact ⟨p, hp, hkey⟩

theorem certOK_of_tabled {st : State} (h : Tabled st) : certOK st = true := by
  obtain ⟨p, hp, hkey⟩ := h
  have hk : skey p.1 = p.2.1 :=
    of_decide_eq_true (List.all_eq_true.mp distTab_keys p hp)
  have hse : p.1 = st := skey_inj (hk.trans hkey)
  have hmem : p.1 ∈ distTab.map (fun p => p.1) := List.mem_map_of_mem hp
  have h1 := List.all_eq_true.mp cert_all p.1 hmem
  rw [← hse]; exact h1

/-! ## §3. The induction -/

/-- **THE PLAY BOUND.**  Along any witness play from a tabled state, `D`
drops by at most one per letter, and every visited state stays tabled. -/
theorem play_bound : ∀ {x v : State} {ρ : List Move},
    ShufflePlayW x ρ v → x.WF → Tabled x →
    D x ≤ D v + ρ.length ∧ Tabled v := by
  intro x v ρ hplay
  induction hplay with
  | nil => intro _ hxt; exact ⟨by omega, hxt⟩
  | @cons x t v m rest hrev hstep hrest ih =>
      intro hxwf hxt
      have htwf := step_wf hxwf hstep
      have hrev' : reversibleOf x m = true :=
        (reversibleOf_iff_reversibleAtW hxwf m).mpr hrev
      obtain ⟨hD, hcp⟩ := cert_step (certOK_of_tabled hxt) hrev' hstep
      obtain ⟨hb, hvt⟩ := ih htwf (tabled_of_D_lt hD)
      refine ⟨?_, hvt⟩
      have hl : (m :: rest).length = rest.length + 1 := rfl
      omega

/-! ## §4. The bound -/

theorem D_s0 : D s0 = 13 := by decide
theorem D_s13 : D s13 = 0 := by decide

theorem s0_tabled : Tabled s0 := tabled_of_D_lt (by rw [D_s0]; decide)

/-- **THE WITNESS IS UNIT-SHORTEST — UNCONDITIONALLY, FLAT MEMORY.** -/
theorem witnessMinimality : WitnessMinimality := by
  intro ρ hρ
  obtain ⟨hb, -⟩ := play_bound hρ s0_wf s0_tabled
  rw [D_s0, D_s13] at hb
  omega

/-- **`v` IS NOT REACHABLE FROM `u` IN ≤ 12 REVERSIBLE STEPS.** -/
theorem not_reach12 : memCode s13 (reachN s0 12) = false := by
  cases h : memCode s13 (reachN s0 12)
  · rfl
  · exfalso
    obtain ⟨hr, -⟩ := (reach_spec 12 s0 s0_wf).1 s13 (mem_of_memCode h)
    obtain ⟨ρ, hρ, hlen⟩ := hr
    have h13 := witnessMinimality ρ hρ
    omega

/-- **THE NAMED BOOL IS DISCHARGED.** -/
theorem bfs12 : Bfs12 := not_reach12

/-- **THE 13-LETTER WITNESS PLAY IS UNIT-SHORTEST.** -/
theorem play_shortest (ρ' : List Move) (h' : ShufflePlayW s0 ρ' s13) :
    rho.length ≤ ρ'.length := by
  have h13 := witnessMinimality ρ' h'
  have hlen : rho.length = 13 := by decide
  omega

