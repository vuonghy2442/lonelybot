import Orig2.ForkEqualRungBoard
import Orig2.ForkEqualRungBall

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option maxRecDepth 1000000
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

/-!
# EqualRung_Min — no witness play of length `< 13` joins `u` and `v`

READ-ONLY scratch card.  No source file is modified; nothing is committed.
Zero `sorry`, zero `Classical.choice`, zero `native_decide`.

## The method

A **kernel BFS** over the reversible-move graph, run by `decide`:

* `allMoves st` is a *complete* candidate letter list — `step_mem_allMoves`
  proves every reversible legal letter of `st` occurs in it (the candidates are
  read off the state: the next-up card per suit, the foundation tops, the
  face-up cards, and the bases = the seven anchors plus the pile tops);
* `succsOf st` filters by the certified oracle `reversibleOf` and steps;
* `reachN st n` is the ball of states reachable in `≤ n` reversible steps
  (`reachStep` grows the *whole* seen set's successors, which makes the
  completeness proof a short induction; each round inserts every new state
  at most once — `insertNew` — without which the balls grow like PATH counts,
  not state counts, and the computation is memory-infeasible);
* the bound is checked ROUND BY ROUND against `Orig2/ForkEqualRungBall.lean`
  (`B k`, generated by `Temp/EqualRung_ball_gen.py` from the exact
  `reachStep` semantics: the `Card.universe`/`Suit.all`/`Anchor.all`
  enumeration orders, the `reversibleOf` filter, the `insertNew` dedup):
  `step_Bk : reachStep B(k−1) = Bk` by `rfl`, the chain
  `rk : reachN s0 k = B k`, and `not_reach12 : memCode s13 B12 = false` by
  `decide`.

Hence no `ShufflePlayW s0 ρ s13` has `ρ.length ≤ 12`, while `play` has length
13: the witness is **unit-shortest**.

`Temp/Crack_witness.py` reports the same BFS distance (13) over the 392-state
component; this card certifies it in the kernel against the Lean `State.step`
relation itself, independently of the probe.

## The state key

Dedup uses `skey`, which is injective (`skey_inj`, `Orig2/ForkEqualRungBoard.lean`),
so dropping an already-seen state is sound (no hash collisions).
-/

namespace EqualRung

/-! ## §1. The complete candidate letter list -/

/-- Every face-up card of every pile. -/
def faceUpCards (st : State) : List Card :=
  Anchor.all.flatMap (fun a => (st.piles a).faceUp)

/-- Every pile top. -/
def pileTopCards (st : State) : List Card :=
  Anchor.all.filterMap (fun a => st.topOf a)

/-- Every foundation top. -/
def foundTopCards (st : State) : List Card :=
  Suit.all.filterMap (fun s => st.foundTop s)

/-- Every next-up card (at most one per suit). -/
def nextUpCards (st : State) : List Card :=
  Card.universe.filter (fun c => st.nextUp c)

/-- Every candidate landing base: an anchor, or the top of a pile. -/
def allBases (st : State) : List Base :=
  Anchor.all.map Sum.inl ++ Anchor.all.filterMap (fun a => (st.topOf a).map Sum.inr)

/-- The candidate letters (a superset of the reversible legal ones). -/
def allMoves (st : State) : List Move :=
  [[Move.draw],
   st.waste.map Move.wasteToFound,
   (nextUpCards st).map Move.tabToFound,
   (foundTopCards st).flatMap (fun c => (allBases st).map (fun b => Move.foundToTab c b)),
   (faceUpCards st).flatMap (fun c => (allBases st).map (fun b => Move.tabToTab c b))].flatMap id

/-- The reversible successors. -/
def succsOf (st : State) : List State :=
  ((allMoves st).filter (fun m => reversibleOf st m)).filterMap (fun m => st.step m)

/-! ### §1a. Membership kit -/

theorem mem_allMoves_draw (st : State) : Move.draw ∈ allMoves st :=
  List.mem_flatMap.mpr ⟨[Move.draw], by simp, by simp⟩

theorem mem_allMoves_wasteToFound {st : State} {c : Card} (h : c ∈ st.waste) :
    Move.wasteToFound c ∈ allMoves st :=
  List.mem_flatMap.mpr
    ⟨st.waste.map Move.wasteToFound, by simp, List.mem_map.mpr ⟨c, h, rfl⟩⟩

theorem mem_allMoves_tabToFound {st : State} {c : Card} (h : c ∈ nextUpCards st) :
    Move.tabToFound c ∈ allMoves st :=
  List.mem_flatMap.mpr
    ⟨(nextUpCards st).map Move.tabToFound, by simp, List.mem_map.mpr ⟨c, h, rfl⟩⟩

theorem mem_allMoves_foundToTab {st : State} {c : Card} {b : Base}
    (hc : c ∈ foundTopCards st) (hb : b ∈ allBases st) :
    Move.foundToTab c b ∈ allMoves st :=
  List.mem_flatMap.mpr
    ⟨(foundTopCards st).flatMap (fun c' => (allBases st).map (fun b' => Move.foundToTab c' b')),
     by simp, List.mem_flatMap.mpr ⟨c, hc, List.mem_map.mpr ⟨b, hb, rfl⟩⟩⟩

theorem mem_allMoves_tabToTab {st : State} {c : Card} {b : Base}
    (hc : c ∈ faceUpCards st) (hb : b ∈ allBases st) :
    Move.tabToTab c b ∈ allMoves st :=
  List.mem_flatMap.mpr
    ⟨(faceUpCards st).flatMap (fun c' => (allBases st).map (fun b' => Move.tabToTab c' b')),
     by simp, List.mem_flatMap.mpr ⟨c, hc, List.mem_map.mpr ⟨b, hb, rfl⟩⟩⟩

theorem mem_allBases_inl (st : State) (a : Anchor) : Sum.inl a ∈ allBases st :=
  List.mem_append_left _ (List.mem_map.mpr ⟨a, Anchor.mem_all a, rfl⟩)

theorem mem_allBases_inr {st : State} {z : Card} (h : ∃ a, st.topOf a = some z) :
    Sum.inr z ∈ allBases st := by
  obtain ⟨a, ha⟩ := h
  exact List.mem_append_right _
    (List.mem_filterMap.mpr ⟨a, Anchor.mem_all a, by simp [ha]⟩)

/-- From a legal `inr` landing, the base card tops a pile. -/
theorem canPlace_inr_top {st : State} {c z : Card}
    (h : st.canPlace c (Sum.inr z) = true) : ∃ a, st.topOf a = some z := by
  cases hp : st.pileOfTop z with
  | none =>
      have h' : st.canPlace c (Sum.inr z) = false := by
        show (match st.pileOfTop z with
              | some _ => canSitOn c z
              | none => false) = false
        rw [hp]
      rw [h'] at h; exact absurd h (by simp)
  | some a =>
      refine ⟨a, ?_⟩
      exact of_decide_eq_true (firstWhere_sound
        (fun a' => decide (st.topOf a' = some z)) hp)

/-! ### §1b. Facts read off the three non-waste branches -/

theorem tabToFound_facts {st t : State} {c : Card}
    (h : st.step (Move.tabToFound c) = some t) :
    st.nextUp c = true ∧ ∃ a, st.pileOfTop c = some a := by
  rw [step_tabToFound_eq] at h
  by_cases hn : st.nextUp c = true
  · rw [if_pos hn] at h
    refine ⟨hn, ?_⟩
    cases hp : st.pileOfTop c with
    | none => rw [hp] at h; exact absurd h (by simp)
    | some a => exact ⟨a, rfl⟩
  · rw [if_neg hn] at h; exact absurd h (by simp)

theorem foundToTab_facts {st t : State} {c : Card} {b : Base}
    (h : st.step (Move.foundToTab c b) = some t) :
    st.foundTop c.suit = some c ∧ st.canPlace c b = true := by
  rw [step_foundToTab_eq] at h
  cases hft : st.foundTop c.suit with
  | none => rw [hft] at h; exact absurd h (by simp)
  | some c' =>
      rw [hft] at h
      dsimp only at h
      split at h
      · rename_i hc
        have h1 : decide (c' = c) = true := (Bool.and_eq_true _ _).mp hc |>.1
        have h2 : st.canPlace c b = true := (Bool.and_eq_true _ _).mp hc |>.2
        have h3 : c' = c := of_decide_eq_true h1
        subst h3
        exact ⟨rfl, h2⟩
      · simp at h

theorem tabToTab_facts {st t : State} {c : Card} {b : Base}
    (h : st.step (Move.tabToTab c b) = some t) :
    (∃ a, st.pileHolding c = some a) ∧ st.canPlace c b = true := by
  rw [step_tabToTab_eq] at h
  cases hp : st.pileHolding c with
  | none => rw [hp] at h; exact absurd h (by simp)
  | some a =>
      rw [hp] at h
      dsimp only at h
      split at h
      · rename_i hc
        exact ⟨⟨a, rfl⟩, hc⟩
      · simp at h

/-- **EVERY REVERSIBLE LEGAL LETTER IS IN THE CANDIDATE LIST.** -/
theorem step_mem_allMoves {st t : State} {m : Move}
    (hrev : reversibleOf st m = true) (hstep : st.step m = some t) :
    m ∈ allMoves st := by
  cases m with
  | draw => exact mem_allMoves_draw st
  | wasteToFound c => exact absurd hrev (by simp [reversibleOf])
  | wasteToTab c b => exact absurd hrev (by simp [reversibleOf])
  | tabToFound c =>
      obtain ⟨hn, -⟩ := tabToFound_facts hstep
      exact mem_allMoves_tabToFound (List.mem_filter.mpr ⟨Card.mem_universe c, hn⟩)
  | foundToTab c b =>
      obtain ⟨hft, hcp⟩ := foundToTab_facts hstep
      refine mem_allMoves_foundToTab
        (List.mem_filterMap.mpr ⟨c.suit, Suit.mem_all c.suit, hft⟩) ?_
      cases b with
      | inl a => exact mem_allBases_inl st a
      | inr z => exact mem_allBases_inr (canPlace_inr_top hcp)
  | tabToTab c b =>
      obtain ⟨⟨a, hph⟩, hcp⟩ := tabToTab_facts hstep
      have hph' : firstWhere (fun a' => decide (c ∈ (st.piles a').faceUp)) Anchor.all
          = some a := hph
      refine mem_allMoves_tabToTab
        (List.mem_flatMap.mpr ⟨a, Anchor.mem_all a,
          of_decide_eq_true (firstWhere_sound
            (fun a' => decide (c ∈ (st.piles a').faceUp)) hph')⟩) ?_
      cases b with
      | inl a => exact mem_allBases_inl st a
      | inr z => exact mem_allBases_inr (canPlace_inr_top hcp)

/-- **SUCCESSOR COMPLETENESS.** -/
theorem succ_mem_succsOf {st t : State} {m : Move}
    (hrev : reversibleOf st m = true) (hstep : st.step m = some t) :
    t ∈ succsOf st :=
  List.mem_filterMap.mpr
    ⟨m, List.mem_filter.mpr ⟨step_mem_allMoves hrev hstep, hrev⟩, hstep⟩

/-! ## §2. The visited-set key and the bounded search -/

/-- Key-level membership of a state in a list. -/
def memCode (z : State) (xs : List State) : Bool :=
  xs.any (fun x => decide (skey x = skey z))

theorem memCode_of_mem {z : State} {xs : List State} (h : z ∈ xs) :
    memCode z xs = true := by
  unfold memCode
  exact List.any_eq_true.mpr ⟨z, h, by simp⟩

theorem eq_of_memCode {z : State} {xs : List State} (h : memCode z xs = true) :
    ∃ x ∈ xs, x = z := by
  unfold memCode at h
  obtain ⟨x, hx, hk⟩ := List.any_eq_true.mp h
  exact ⟨x, hx, skey_inj (of_decide_eq_true hk)⟩

theorem mem_of_memCode {z : State} {xs : List State} (h : memCode z xs = true) :
    z ∈ xs := by
  obtain ⟨x, hx, hxz⟩ := eq_of_memCode h
  simpa [hxz] using hx

/-- One insert for the BFS round: `v` enters the batch only if unseen in BOTH
the seen set and the accumulating batch.  The batch-internal dedup is what
bounds the ball by the component size: without it, a state reachable by `m`
predecessors enters the ball `m` times and the multiplicities compound round
over round (path counts, not state counts), which is what made the one-shot
decide memory-infeasible. -/
def insertNew (seen : List State) (acc : List State) (v : State) : List State :=
  if memCode v seen || memCode v acc then acc else acc ++ [v]

/-- One BFS round: the seen set plus the unseen successors of the seen set,
each new state inserted at most once (first occurrence wins). -/
def reachStep (seen : List State) : List State :=
  seen ++ (seen.flatMap succsOf).foldl (insertNew seen) []

/-- The states reachable from `st` in `≤ n` reversible steps. -/
def reachN (st : State) : Nat → List State
  | 0 => [st]
  | n + 1 => reachStep (reachN st n)

/-! ### The fold lemmas -/

theorem mem_insertNew_keep {seen acc : List State} {u w : State}
    (h : u ∈ acc) : u ∈ insertNew seen acc w := by
  unfold insertNew
  split
  · exact h
  · exact List.mem_append_left _ h

theorem fold_insertNew_keep {seen : List State} :
    ∀ (l : List State) (acc : List State) (u : State), u ∈ acc →
      u ∈ l.foldl (insertNew seen) acc
  | [], _, _, h => h
  | w :: t, acc, u, h =>
      fold_insertNew_keep t (insertNew seen acc w) u (mem_insertNew_keep h)

theorem mem_of_insertNew {seen acc : List State} {u w : State}
    (h : u ∈ insertNew seen acc w) : u ∈ acc ∨ u = w := by
  unfold insertNew at h
  split at h
  · exact Or.inl h
  · rcases List.mem_append.mp h with h1 | h2
    · exact Or.inl h1
    · rcases List.mem_cons.mp h2 with rfl | hnil
      · exact Or.inr rfl
      · exact absurd hnil (by simp)

theorem fold_insertNew_sub {seen : List State} :
    ∀ (l : List State) (acc : List State) (u : State),
      u ∈ l.foldl (insertNew seen) acc → u ∈ acc ∨ u ∈ l
  | [], _, _, h => Or.inl h
  | w :: t, acc, u, h => by
      rcases fold_insertNew_sub t (insertNew seen acc w) u h with hu | hu
      · rcases mem_of_insertNew hu with h1 | h2
        · exact Or.inl h1
        · exact Or.inr (by rw [h2]; exact List.mem_cons_self ..)
      · exact Or.inr (List.mem_cons.mpr (Or.inr hu))

theorem fold_insertNew_mem {seen : List State} :
    ∀ (l : List State) (acc : List State) (v : State), v ∈ l →
      v ∈ l.foldl (insertNew seen) acc ∨ memCode v seen = true
  | [], _, _, h => absurd h (by simp)
  | w :: t, acc, v, hv => by
      rcases List.mem_cons.mp hv with rfl | ht
      · by_cases hc : (memCode v seen || memCode v acc) = true
        · rcases Bool.or_eq_true_iff.mp hc with hs | ha
          · exact Or.inr hs
          · exact Or.inl (fold_insertNew_keep t (insertNew seen acc v) v
              (mem_insertNew_keep (mem_of_memCode ha)))
        · exact Or.inl (fold_insertNew_keep t (insertNew seen acc v) v
            (by
              unfold insertNew
              rw [if_neg hc]
              exact List.mem_append_right _ (List.mem_cons_self ..)))
      · exact fold_insertNew_mem t (insertNew seen acc w) v ht

/-! ## §3. `ReachLE` and the soundness/completeness of `reachN` -/

/-- Reachable by a witness play of length `≤ n`. -/
def ReachLE (a : State) (n : Nat) (x : State) : Prop :=
  ∃ ρ : List Move, ShufflePlayW a ρ x ∧ ρ.length ≤ n

theorem ReachLE_mono {a x : State} {m n : Nat} (h : ReachLE a m x) (hmn : m ≤ n) :
    ReachLE a n x := by
  obtain ⟨ρ, hρ, hlen⟩ := h
  exact ⟨ρ, hρ, Nat.le_trans hlen hmn⟩

/-- Appending one reversible leg. -/
theorem ReachLE_succ {a y : State} {n : Nat} {m : Move} {x : State}
    (hy : ReachLE a n y) (hywf : y.WF)
    (hrev : reversibleOf y m = true) (hst : y.step m = some x) :
    ReachLE a (n + 1) x := by
  obtain ⟨ρ, hρ, hlen⟩ := hy
  have hrev' : reversibleAtW y m := (reversibleOf_iff_reversibleAtW hywf m).mp hrev
  refine ⟨ρ ++ [m], ?_, ?_⟩
  · exact ShufflePlayW_append hρ (Walk.cons hrev' hst (Walk.nil x))
  · rw [List.length_append, List.length_singleton]
    omega

/-- A one-letter witness play, read off. -/
theorem walk_one {a x : State} {m : Move} (h : ShufflePlayW a [m] x) :
    reversibleAtW a m ∧ a.step m = some x := by
  cases h with
  | cons hrev hst hrest =>
      cases hrest with
      | nil => exact ⟨hrev, hst⟩

/-- Every nonempty move list is a prefix plus a last letter. -/
theorem exists_snoc : ∀ (l : List Move), l ≠ [] →
    ∃ (pre : List Move) (m : Move), l = pre ++ [m]
  | [], h => absurd rfl h
  | [m], _ => ⟨[], m, rfl⟩
  | a :: b :: t, _ => by
      obtain ⟨pre, m, heq⟩ := exists_snoc (b :: t) (by simp)
      exact ⟨a :: pre, m, by simp [heq]⟩

/-- **SPLIT A WITNESS PLAY AT ITS LAST LETTER.** -/
theorem walk_last {m : Move} :
    ∀ (pre : List Move) (a x : State), ShufflePlayW a (pre ++ [m]) x →
      ∃ y : State, ShufflePlayW a pre y ∧ ShufflePlayW y [m] x
  | [], a, x, h => ⟨a, Walk.nil a, h⟩
  | p :: ps, a, x, h => by
      have h' : ShufflePlayW a (p :: (ps ++ [m])) x := by
        rw [← List.cons_append]; exact h
      cases h' with
      | cons hrev hstep hrest =>
          obtain ⟨y, hpre, hlast⟩ := walk_last ps _ x hrest
          exact ⟨y, Walk.cons hrev hstep hpre, hlast⟩

/-- A list of length zero is empty. -/
theorem length_zero_nil {l : List Move} (h : l.length = 0) : l = [] := by
  cases l with
  | nil => rfl
  | cons m t => simp at h

/-- The start state is always in its own ball. -/
theorem self_mem_reachN (a : State) : ∀ n : Nat, a ∈ reachN a n
  | 0 => by simp [reachN]
  | n + 1 => by
      show a ∈ reachStep (reachN a n)
      rw [reachStep]
      exact List.mem_append_left _ (self_mem_reachN a n)

/-- **ONE LEG INTO THE NEXT BALL.** -/
theorem reach_step_mem {n : Nat} {a y x : State} {m : Move}
    (hseen : y ∈ reachN a n) (hywf : y.WF)
    (hrev : reversibleOf y m = true) (hst : y.step m = some x) :
    memCode x (reachN a (n + 1)) = true := by
  have hxsucc : x ∈ succsOf y := succ_mem_succsOf hrev hst
  have hxs : x ∈ (reachN a n).flatMap succsOf :=
    List.mem_flatMap.mpr ⟨y, hseen, hxsucc⟩
  show memCode x (reachStep (reachN a n)) = true
  rw [reachStep]
  rcases fold_insertNew_mem _ _ _ hxs with h | h
  · exact memCode_of_mem (List.mem_append_right _ h)
  · exact memCode_of_mem (List.mem_append_left _ (mem_of_memCode h))

/-! ## §4. `reachN` is exactly the ball of radius `n` -/

theorem reach_spec (n : Nat) (a : State) (hawf : a.WF) :
    (∀ x ∈ reachN a n, ReachLE a n x ∧ x.WF) ∧
    (∀ x, ReachLE a n x → memCode x (reachN a n) = true) := by
  induction n with
  | zero =>
      constructor
      · intro x hx
        have hxa : x = a := by simpa [reachN] using hx
        rw [hxa]
        exact ⟨⟨[], Walk.nil a, Nat.zero_le 0⟩, hawf⟩
      · intro x hx
        obtain ⟨ρ, hρ, hlen⟩ := hx
        have h0 : ρ.length = 0 := Nat.le_zero.mp hlen
        have hnil := length_zero_nil h0
        subst hnil
        cases hρ
        exact memCode_of_mem (by simp [reachN])
  | succ n ih =>
      obtain ⟨ihs, ihc⟩ := ih
      constructor
      · -- soundness
        intro x hx
        have hx' : x ∈ reachN a n ∨ x ∈ (reachN a n).flatMap succsOf := by
          have hx'' : x ∈ reachStep (reachN a n) := hx
          rw [reachStep] at hx''
          rcases List.mem_append.mp hx'' with h | h
          · exact Or.inl h
          · exact Or.inr ((fold_insertNew_sub _ _ _ h).resolve_left (by simp))
        rcases hx' with hx' | hx'
        · obtain ⟨hr, hw⟩ := ihs x hx'
          exact ⟨ReachLE_mono hr (Nat.le_succ n), hw⟩
        · obtain ⟨y, hy, hxy⟩ := List.mem_flatMap.mp hx'
          obtain ⟨hr, hywf⟩ := ihs y hy
          obtain ⟨m, hm, hst⟩ := List.mem_filterMap.mp hxy
          obtain ⟨-, hrev⟩ := List.mem_filter.mp hm
          exact ⟨ReachLE_succ hr hywf hrev hst, step_wf hywf hst⟩
      · -- completeness
        intro x hx
        obtain ⟨ρ, hρ, hlen⟩ := hx
        by_cases hnil : ρ = []
        · subst hnil
          cases hρ
          exact memCode_of_mem (self_mem_reachN _ (n + 1))
        · obtain ⟨pre, mlast, hpre⟩ := exists_snoc ρ hnil
          have hρ' : ShufflePlayW a (pre ++ [mlast]) x := by
            rw [← hpre]; exact hρ
          obtain ⟨y, hyl, hlast⟩ := walk_last pre a x hρ'
          have hylen : pre.length ≤ n := by
            have h1 : (pre ++ [mlast]).length ≤ n + 1 := by rw [← hpre]; exact hlen
            rw [List.length_append, List.length_singleton] at h1
            omega
          have hyreach : ReachLE a n y := ⟨pre, hyl, hylen⟩
          have hyseen : y ∈ reachN a n := mem_of_memCode (ihc y hyreach)
          have hywf : y.WF := SatDifferCensus.ShufflePlayW.wf_end hyl hawf
          obtain ⟨hrevw, hst⟩ := walk_one hlast
          have hrev : reversibleOf y mlast = true :=
            (reversibleOf_iff_reversibleAtW hywf mlast).mpr hrevw
          exact reach_step_mem hyseen hywf hrev hst


/-! ## §5. The BFS ball — `#eval` evidence and the single unproved Bool

**SCOPE AND MEMORY NOTE.**  The equal-rung witness below is **OUT OF SCOPE**
for the campaign since the mountain hypothesis was re-gated
(`MountainGate.MountainAtSplitsDiffering`, `Orig2/Fork/Split/ForkMountainGate.lean`): an
equal-rung play cannot refute the gated form.  This card therefore stops at the
honest boundary and does **not** claim minimality.  (Minimality is discharged
separately in `Orig2/ForkEqualRungDist.lean`; the under-gated
`Direct.MountainAtSplits` is refuted unconditionally in
`Orig2/ForkEqualRungMain.lean`.)

It also records *why* the `by decide` attempt was abandoned: `decide` on
`memCode s13 (reachN s0 12)` puts the whole reversible graph — a `Decidable`
term over `State`, whose fields are *functions* — into one reduction, and the
OLD (non-dedup'd) `reachStep` made the balls grow like PATH counts, not state
counts, which is memory-infeasible.  The fix, both in `reachStep` (`insertNew`
batch dedup) and in the certificate shape, is §5b below: the balls as
per-round literals (`Orig2/ForkEqualRungBall.lean`, from
`Temp/EqualRung_ball_gen.py`), each round checked by `rfl`.

What *is* certified here: `step_mem_allMoves` (the candidate letter list is
complete for reversible legal letters) and `reach_spec` (`reachN a n` is exactly
the ball of radius `n`).  Hence the entire remaining obligation is the single
Bool equation `Bfs12`.
-/


/-- **THE ONE UNPROVED BOOL.**  If this equation holds, `v` is outside the ball
of radius 12 around `u`, i.e. the 13-letter play is unit-shortest. -/
def Bfs12 : Prop := memCode s13 (reachN s0 12) = false

/-- **THE MINIMALITY TARGET** — named, unproved; a `def`, never an `axiom`. -/
def WitnessMinimality : Prop := ∀ ρ : List Move, ShufflePlayW s0 ρ s13 → 13 ≤ ρ.length

/-- **MINIMALITY FROM THE BFS EQUATION.**  This is exactly the reduction a
distance-table certificate would discharge; everything else is proved. -/
theorem witnessMinimality_of_bfs (h : Bfs12) : WitnessMinimality := by
  intro ρ hρ
  rcases Nat.lt_or_ge ρ.length 13 with hlt | hge
  · exfalso
    have hle : ρ.length ≤ 12 := Nat.le_of_lt_succ hlt
    have hcode : memCode s13 (reachN s0 12) = true :=
      (reach_spec 12 s0 s0_wf).2 s13 ⟨ρ, hρ, hle⟩
    have hf : memCode s13 (reachN s0 12) = false := h
    rw [hf] at hcode
    exact absurd hcode (by simp)
  · exact hge

/-! ### §5b — THE ONE OPEN STEP, AND THE CERTIFICATE THAT WOULD CLOSE IT

`Bfs12` is **NOT** discharged here, and this card does not claim it.  (The
generated balls survive in `Orig2/ForkEqualRungBall.lean`, from
`Temp/EqualRung_ball_gen.py`, as *data only*: no `rfl` round-check is emitted.)

Why the obvious two routes were abandoned — both are *memory* failures, not
proof failures:

* `decide (memCode s13 (reachN s0 12) = false)`: one `Decidable` term over the
  whole reversible graph, whose nodes are `State`s — and a `State`'s `found`
  and `piles` fields are **functions**, so every normal form is large.  It
  needs `maxRecDepth` in the thousands and exhausts the heartbeat budget.
* `reachStep B(k-1) = Bk` by `rfl` (per-round literals): one round of
  `(ball).flatMap succsOf` still holds thousands of live `State` terms at once.

The certificate that **would** close it, and that stays inside the memory
budget, is a **distance table over `Nat` ids**:

```text
tbl : List State                    -- 392 component states, ids = positions
d   : List Nat                      -- d i = distance from (tbl i) to v
1.  d at v's id        = 0
2.  d at u's id        = 13
3.  for every id i and every reversible legal letter m of tbl i:
        (tbl i).step m = some s  ->  ∃ j, tbl j = s ∧ d i ≤ d j + 1
```

(3) is a **local, per-state** check — one state's candidate letters at a time,
a small transient — and `reach_spec` is not even needed for it: (1)+(2)+(3) give
`13 ≤ |ρ|` for every witness play `ρ` by induction along it.  What is missing
is only the generated table plus the 392 local step checks; nothing here is
unproved mathematics. -/

end EqualRung

