/-!
# Temp/Frame - the `pre ≠ []` strata of `Pin.BottomNotBothRaisable`

READ-ONLY scratch.  No source edit, no commit.  Zero `sorry`, zero
`Classical.choice`, zero `native_decide`; battery at the tail.

## What this card records

`Temp/Both_Report.md` closed the `pre = []` lane of
`Pin.BottomNotBothRaisable` (`Both.bottomNotBothRaisableNil`).  This card
isolates the **pull-headed** lane.

The load-bearing observation is that the live set at a split bottom is

```text
{c, c.twin} ∪ PrePullPair pre
```

(`PinRight.live_at_bottom_of_split`), and `PrePullPair pre e` ("`e` is a card
pulled in `pre`, or its twin") is a *free monoid* over the pull letters of
`pre`: free letters can be stripped from the head, and a pull letter contributes
exactly its own twin pair (`prePullPair_free_head`, `prePullPair_pull_head`,
`prePullPair_strip_free`).  Consequently the residual in the pull-headed lane
mentions only the **pull letters** of `pre`, not `pre` itself.

The residual is named `PrePullRaise` (the raise card IS a pre-pull card or its
twin).  It is the exact negation form of `PinRight.NoPrePullRaise`; the one
constructive direction is proved.  The residual itself is NOT proved here (see
`Frame_Report.md` for the exact state and what is missing).
-/

namespace Frame

open SplitKit

/-! ## 1. `PrePullPair` is a free monoid over the pull letters -/

theorem prePullPair_nil {e : Card} : ¬ PinRight.PrePullPair [] e := by
  rintro ⟨z, b, hmem, -⟩
  exact List.not_mem_nil hmem

theorem prePullPair_cons_iff {m : Move} {pre2 : List Move} {e : Card} :
    PinRight.PrePullPair (m :: pre2) e ↔
      ((∃ z b, m = Move.foundToTab z b ∧ (e = z ∨ e = z.twin)) ∨
        PinRight.PrePullPair pre2 e) := by
  constructor
  · rintro ⟨z, bz, hmem, hez⟩
    rcases List.mem_cons.mp hmem with h | h
    · exact Or.inl ⟨z, bz, h.symm, hez⟩
    · exact Or.inr ⟨z, bz, h, hez⟩
  · rintro (⟨z, bz, rfl, hez⟩ | h)
    · exact ⟨z, bz, List.mem_cons_self .., hez⟩
    · obtain ⟨z, bz, hmem, hez⟩ := h
      exact ⟨z, bz, List.mem_cons_of_mem _ hmem, hez⟩

/-- **A FREE HEAD CAN BE STRIPPED.** -/
theorem prePullPair_free_head {m : Move} {pre2 : List Move} {e : Card}
    (hm : ValleyElim.FreeMove m) :
    PinRight.PrePullPair (m :: pre2) e ↔ PinRight.PrePullPair pre2 e := by
  rw [prePullPair_cons_iff]
  constructor
  · rintro (⟨z, bz, hz, -⟩ | h)
    · rcases hm with rfl | ⟨x, bb, rfl⟩ <;> cases hz
    · exact h
  · exact Or.inr

/-- **A PULL HEAD CONTRIBUTES EXACTLY ITS TWIN PAIR.** -/
theorem prePullPair_pull_head {z : Card} {b : Base} {pre2 : List Move} {e : Card} :
    PinRight.PrePullPair (Move.foundToTab z b :: pre2) e ↔
      (e = z ∨ e = z.twin ∨ PinRight.PrePullPair pre2 e) := by
  rw [prePullPair_cons_iff]
  constructor
  · rintro (⟨z', bz, hz', hez⟩ | h)
    · have hzz : z' = z := by
        injection hz' with h1 h2
        exact h1.symm
      rw [hzz] at hez
      exact hez.elim Or.inl (fun hh => Or.inr (Or.inl hh))
    · exact Or.inr (Or.inr h)
  · intro hh
    rcases hh with h1 | h1 | h
    · rw [h1]
      exact Or.inl ⟨z, b, rfl, Or.inl rfl⟩
    · rw [h1]
      exact Or.inl ⟨z, b, rfl, Or.inr rfl⟩
    · exact Or.inr h

/-- **THE WHOLE FREE PREFIX STRIPS.** -/
theorem prePullPair_strip_free :
    ∀ (fs : List Move), (∀ m ∈ fs, ValleyElim.FreeMove m) →
      ∀ (pre2 : List Move) (e : Card),
        (PinRight.PrePullPair (fs ++ pre2) e ↔ PinRight.PrePullPair pre2 e) := by
  intro fs
  induction fs with
  | nil =>
      intro _ pre2 e
      rw [List.nil_append]
  | cons m ms ih =>
      intro hfree pre2 e
      have hm : ValleyElim.FreeMove m := hfree m (List.mem_cons_self ..)
      have htail : ∀ m' ∈ ms, ValleyElim.FreeMove m' :=
        fun m' hm' => hfree m' (List.mem_cons_of_mem _ hm')
      rw [List.cons_append, prePullPair_free_head hm, ih htail pre2 e]

theorem prePullPair_mono {pre post : List Move} {e : Card}
    (h : PinRight.PrePullPair pre e) :
    PinRight.PrePullPair (pre ++ post) e := by
  obtain ⟨z, b, hmem, hez⟩ := h
  exact ⟨z, b, List.mem_append_left _ hmem, hez⟩

/-- `pre` with no pull letter has an EMPTY `PrePullPair`. -/
theorem prePullPair_eq_false_of_no_pull {pre : List Move} {e : Card}
    (h : ∀ m ∈ pre, ∀ z b, m ≠ Move.foundToTab z b) :
    ¬ PinRight.PrePullPair pre e := by
  rintro ⟨z, b, hmem, -⟩
  exact h (Move.foundToTab z b) hmem z b rfl

/-- **THE FIRST PULL AFTER THE FREE PREFIX.**  At a split with a raise-free
left leg, the block, and a prefix of the shape s ++ pull z :: rest (with s
free), the raise card is c.twin, or z, or z.twin, or a card of the tail's
PrePullPair.  So the pull-headed lane's live set is generated by the FIRST
pull after the free prefix plus the tail. -/
theorem raise_eq_twin_or_firstPull
    {u v : State} {ρ : List Move} {F : State} {left right : List Move}
    {c d : Card} {b : Base} {pre post tail : List Move}
    (hs : SplitKit.SplitHyp u v ρ F left right c d b pre post tail)
    (hrf : ∀ m ∈ left, ¬ Bubble.IsRaise m)
    (hb : ¬ CanRaise F c)
    {fs : List Move} (hfs : ∀ m ∈ fs, ValleyElim.FreeMove m)
    {z : Card} {bz : Base} {rest : List Move}
    (hpre : pre = fs ++ Move.foundToTab z bz :: rest) :
    d = c.twin ∨ d = z ∨ d = z.twin ∨ PinRight.PrePullPair rest d := by
  rcases PinRight.raise_eq_twin_or_prePull hs hrf hb with hd | hp
  · exact Or.inl hd
  · rw [hpre] at hp
    have h1 := (prePullPair_strip_free fs hfs (Move.foundToTab z bz :: rest) d).mp hp
    have h2 := (prePullPair_pull_head (z := z) (b := bz) (pre2 := rest) (e := d)).mp h1
    exact Or.inr h2

/-! ## 2. The residual, exactly -//-! ## 2. The residual, exactly -/

/-- **`PrePullRaise`** - the raise card IS a card pulled in `pre`, or the twin
of one.  (The negation of `PinRight.NoPrePullRaise`; it mentions no rung, no
licence and no bottom coordinate.) -/
def PrePullRaise : Prop :=
  ∀ (u v : State) (ρ : List Move) (F : State) (left right : List Move)
    (c d : Card) (b : Base) (pre post tail : List Move),
    SplitKit.SplitHyp u v ρ F left right c d b pre post tail →
    (∀ m ∈ left, ¬ Bubble.IsRaise m) →
    PinRight.PrePullPair pre d

/-- **THE RESIDUAL AND THE PIN'S RESIDUAL ARE EXACT NEGATIONS.**  The
constructive direction: a split witnessing `PrePullRaise` refutes
`PinRight.NoPrePullRaise`. -/
def PrePullRaiseNeg : Prop := ¬ PinRight.NoPrePullRaise

end Frame

