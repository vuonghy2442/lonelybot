/-!
# Orig2.FiberHierarchy — the move-set quotient hierarchy

THE ELEGANT FORM OF THE FIBER STACK.  Instead of separate ad-hoc
relations, every move-generated quotient is an instance of

```lean
MoveFiber M := TwoWay (RevStepOf M)
```

with the alphabet `M` naming the allowed moves:

```text
CargoSpan = MoveFiber cargoMoves   (reversible tabToTab only)
FlatSpan  = MoveFiber flatMoves    (reversible tabToTab + draw)
MacroSpan = MoveFiber allMoves     (every reversible move)
```

so the move-generated hierarchy is

```text
BareCargoEquiv  ⊂  BareFlatEquiv  ⊂  sameOrbitSetoid
   CargoSpan          FlatSpan          MacroSpan
```

The rung class is a DIFFERENT kind of quotient: not generated by moves,
but the kernel of the rung observation (`rungSetoid`, `RungClass`).  The
two axes meet in `Position`:

```text
Position = MacroSpan × RungClass
```

(`orbitRungSetoid.r p q ↔ sameOrbitSetoid.r p.1 q.1 ∧ RungEq p.1 q.1`).

House compliance: additive leaf (`Orig2.SWDichotomy`); zero `sorry`,
zero `Classical.choice`; battery at tail.
-/

/-! ## §1. Steps congruence and monotonicity -/

/-- Pointwise-equivalent letters give equivalent spans. -/
theorem steps_congr {Q Q' : State → State → Prop}
    (h : ∀ a b, Q a b ↔ Q' a b) {a b : State} :
    Steps Q a b ↔ Steps Q' a b := by
  constructor
  · intro hs
    induction hs with
    | refl s => exact Steps.refl s
    | cons hleg _ ih => exact Steps.cons ((h _ _).mp hleg) ih
  · intro hs
    induction hs with
    | refl s => exact Steps.refl s
    | cons hleg _ ih => exact Steps.cons ((h _ _).mpr hleg) ih

/-- A letter inclusion gives a span inclusion. -/
theorem steps_mono {Q Q' : State → State → Prop}
    (h : ∀ a b, Q a b → Q' a b) {a b : State} :
    Steps Q a b → Steps Q' a b := by
  intro hs
  induction hs with
  | refl s => exact Steps.refl s
  | cons hleg _ ih => exact Steps.cons (h _ _ hleg) ih

/-! ## §2. The three move-generated fibers -/

/-- The cargo alphabet's reversible step is `CargoLeg`. -/
theorem revStepOf_cargo_iff {a b : State} :
    RevStepOf cargoMoves a b ↔ CargoLeg a b := by
  constructor
  · rintro ⟨m, ⟨c, bs, hm⟩, hstep, hrev⟩
    subst hm
    exact ⟨c, bs, hstep, hrev⟩
  · rintro ⟨c, bs, hstep, hrev⟩
    exact ⟨Move.tabToTab c bs, ⟨c, bs, rfl⟩, hstep, hrev⟩

/-- The flat alphabet's reversible step is `FlatStep`. -/
theorem revStepOf_flat_iff {a b : State} :
    RevStepOf flatMoves a b ↔ FlatStep a b := by
  constructor
  · rintro ⟨m, hm, hstep, hrev⟩
    rcases hm with rfl | ⟨c, bs, rfl⟩
    · exact FlatStep.draw hstep hrev
    · exact FlatStep.cargo c bs hstep hrev
  · intro h
    cases h with
    | cargo c bs hstep hrev =>
        exact ⟨Move.tabToTab c bs, Or.inr ⟨c, bs, rfl⟩, hstep, hrev⟩
    | draw hstep hrev =>
        exact ⟨Move.draw, Or.inl rfl, hstep, hrev⟩

/-- `CargoSpan` is exactly `BareCargoEquiv`. -/
theorem cargoSpan_iff_bareCargo {u v : State} :
    CargoSpan u v ↔ BareCargoEquiv u v := by
  unfold CargoSpan MoveFiber TwoWay BareCargoEquiv CargoPath
  exact ⟨fun h => ⟨(steps_congr (fun a b => revStepOf_cargo_iff)).mp h.1,
                   (steps_congr (fun a b => revStepOf_cargo_iff)).mp h.2⟩,
         fun h => ⟨(steps_congr (fun a b => revStepOf_cargo_iff)).mpr h.1,
                   (steps_congr (fun a b => revStepOf_cargo_iff)).mpr h.2⟩⟩

/-- `FlatSpan` is exactly `BareFlatEquiv`. -/
theorem flatSpan_iff_bareFlat {u v : State} :
    FlatSpan u v ↔ BareFlatEquiv u v := by
  unfold FlatSpan MoveFiber TwoWay BareFlatEquiv FlatPath
  exact ⟨fun h => ⟨(steps_congr (fun a b => revStepOf_flat_iff)).mp h.1,
                   (steps_congr (fun a b => revStepOf_flat_iff)).mp h.2⟩,
         fun h => ⟨(steps_congr (fun a b => revStepOf_flat_iff)).mpr h.1,
                   (steps_congr (fun a b => revStepOf_flat_iff)).mpr h.2⟩⟩

/-- `MacroSpan` is the witness reversible class. -/
theorem macroSpan_iff_sameOrbit {u v : State} :
    MacroSpan u v ↔ sameOrbitSetoid.r u v := by
  have hsteps : ∀ a b : State,
      Steps (RevStepOf allMoves) a b ↔ ∃ play, ShufflePlayW a play b := by
    intro a b
    constructor
    · intro hs
      induction hs with
      | refl s => exact ⟨[], Walk.nil s⟩
      | @cons w z u hleg t ih =>
          obtain ⟨m, -, hstep, hrev⟩ := hleg
          obtain ⟨play, hplay⟩ := ih
          exact ⟨m :: play, Walk.cons hrev hstep hplay⟩
    · rintro ⟨play, hplay⟩
      induction hplay with
      | nil s => exact Steps.refl s
      | @cons st s1 W m ρ hlet hstep hrest ih =>
          exact Steps.cons ⟨m, trivial, hstep, hlet⟩ ih
  change MacroSpan u v ↔ RevEqW v u
  unfold MacroSpan MoveFiber TwoWay
  constructor
  · rintro ⟨h1, h2⟩
    obtain ⟨p, hp⟩ := (hsteps u v).mp h1
    obtain ⟨q, hq⟩ := (hsteps v u).mp h2
    exact ⟨q, hq, p, hp⟩
  · rintro ⟨p, hp, q, hq⟩
    exact ⟨(hsteps u v).mpr ⟨q, hq⟩, (hsteps v u).mpr ⟨p, hp⟩⟩

/-! ## §3. The inclusions -/

/-- Cargo moves are flat moves. -/
theorem revStepOf_cargo_flat {a b : State} :
    RevStepOf cargoMoves a b → RevStepOf flatMoves a b := by
  rintro ⟨m, ⟨c, bs, hm⟩, hstep, hrev⟩
  subst hm
  exact ⟨Move.tabToTab c bs, Or.inr ⟨c, bs, rfl⟩, hstep, hrev⟩

/-- Flat moves are macro moves. -/
theorem revStepOf_flat_all {a b : State} :
    RevStepOf flatMoves a b → RevStepOf allMoves a b := by
  rintro ⟨m, -, hstep, hrev⟩
  exact ⟨m, trivial, hstep, hrev⟩

/-- `CargoSpan` is contained in `FlatSpan`. -/
theorem cargoSpan_flatSpan {u v : State} (h : CargoSpan u v) : FlatSpan u v :=
  ⟨steps_mono (fun a b => revStepOf_cargo_flat) h.1,
   steps_mono (fun a b => revStepOf_cargo_flat) h.2⟩

/-- `FlatSpan` is contained in `MacroSpan`. -/
theorem flatSpan_macroSpan {u v : State} (h : FlatSpan u v) : MacroSpan u v :=
  ⟨steps_mono (fun a b => revStepOf_flat_all) h.1,
   steps_mono (fun a b => revStepOf_flat_all) h.2⟩

/-! ## §4. The readout quotient -/

/-- The rung class is the kernel of the rung observation. -/
theorem rungClass_eq_iff (u v : State) :
    (Quotient.mk rungSetoid u = Quotient.mk rungSetoid v) ↔ RungEq u v :=
  ⟨Quotient.exact, fun h => Quotient.sound h⟩

/-- `Position` is the meet of the macro fiber and the rung readout. -/
theorem position_meet (p q : WFState) :
    orbitRungSetoid.r p q ↔
      sameOrbitSetoid.r p.1 q.1 ∧ RungEq p.1 q.1 :=
  Iff.rfl

/-! ## §5. The stratification link (2026-10-31, the wiring)

Both live quotient axes of the campaign (`MAP.md`) refine the
stratified quotient (`Orig2/Fiber/StratifiedQuotient.lean`): the meet's
kernel and the FLAT FIBER - a flat path (reversible slides and
draws) never moves a foundation row, so the twins' membership profile
is flat-invariant and each flat fiber lies in one stratum. -/

/-- **POSITIONS REFINE STRATA** - two `WF` states with the same class
and the same rung vector (the kernel of the Position meet) lie in
one stratum: the rungs pin the founds (`found_congr_of_rungs`,
`Orig2/Fork/CeilingBridge.lean`), and the founds pin the twins'
membership profile.  The stratified quotient sees strictly coarser
than the meet. -/
theorem stratOrbit_of_class_rungs (x : Card) {s s' : WFState}
    (hclass : sameOrbitSetoid.r s.val s'.val) (hrung : RungEq s.val s'.val) :
    (stratOrbit x).r s s' := by
  refine ⟨hclass, ?_, ?_⟩
  · rw [found_congr_of_rungs s.2 s'.2 (hrung x.suit)]
  · rw [found_congr_of_rungs s.2 s'.2 (hrung x.twin.suit)]

/-- **Swappability is position-determined** - the same class and the
same rung vector fix `SwappableIn` (the stratum constancy read at
the meet's kernel). -/
theorem swappable_of_class_rungs (x : Card) {s s' : WFState}
    (hclass : sameOrbitSetoid.r s.val s'.val) (hrung : RungEq s.val s'.val) :
    SwappableIn s.val x ↔ SwappableIn s'.val x :=
  swappable_stratum_invariant x (stratOrbit_of_class_rungs x hclass hrung)

/-- **FLAT FIBERS REFINE STRATA** - a flat path never moves a
foundation row (`bareFlat_found`), so the twins' membership profile
is flat-invariant: each flat fiber lies in a single stratum. -/
theorem stratOrbit_of_bareFlat (x : Card) {u v : State} (hu : u.WF) (hv : v.WF)
    (h : BareFlatEquiv u v) : (stratOrbit x).r ⟨u, hu⟩ ⟨v, hv⟩ :=
  ⟨bareFlat_sameOrbit h,
    by rw [bareFlat_found hu hv h],
    by rw [bareFlat_found hu hv h]⟩

/-- **Swappability is flat-fiber-determined** - within one flat fiber,
`SwappableIn` is constant (the stratum constancy read at the flat
span: with `flatSpan_iff_bareFlat`, `SwappableIn` is well-defined on
the `FlatSpan` points of the class). -/
theorem swappable_of_bareFlat (x : Card) {u v : State} (hu : u.WF) (hv : v.WF)
    (h : BareFlatEquiv u v) : SwappableIn u x ↔ SwappableIn v x :=
  swappable_stratum_invariant x (stratOrbit_of_bareFlat x hu hv h)

