/-! ## §2. The per-move bound, extracted -/

theorem cert_step {st t : State} {m : Move}
    (hok : certOK st = true)
    (hrev : reversibleOf st m = true) (hst : State.step st m = some t) :
    D t < 999 ∧ D st ≤ D t + 1 := by
  have hm : m ∈ allMoves st := step_mem_allMoves hrev hst
  have h1 := List.all_eq_true.mp hok m hm
  unfold moveOK at h1
  simp only [hrev, if_true, hst, Bool.and_eq_true] at h1
  exact ⟨of_decide_eq_true h1.1, of_decide_eq_true h1.2⟩

/-! ## §3. The lookup lemmas -/

theorem dlookupD_lt {k : List (List Card) × Nat} :
    ∀ (l : List (State × Nat)), dlookupD k l < 999 → ∃ p ∈ l, skey p.1 = k
  | [], h => by simp [dlookupD] at h
  | (s, d) :: t, h => by
      simp only [dlookupD] at h
      by_cases hk : skey s = k
      · exact ⟨_, List.mem_cons_self .., hk⟩
      · rw [if_neg hk] at h
        obtain ⟨p, hp, hkey⟩ := dlookupD_lt t h
        exact ⟨p, List.mem_cons_of_mem _ hp, hkey⟩

theorem dlookupB_lt {rv : List Nat} {k : List (List Card) × Nat} :
    ∀ (l : List (List Nat × List (State × Nat))),
      dlookupB rv k l < 999 → ∃ q ∈ l, ∃ p ∈ q.2, skey p.1 = k
  | [], h => by simp [dlookupB] at h
  | (rv', es) :: t, h => by
      simp only [dlookupB] at h
      by_cases hk : rv' = rv
      · rw [if_pos hk] at h
        obtain ⟨p, hp, hkey⟩ := dlookupD_lt es h
        exact ⟨_, List.mem_cons_self .., p, hp, hkey⟩
      · rw [if_neg hk] at h
        obtain ⟨q, hq, p, hp, hkey⟩ := dlookupB_lt t h
        exact ⟨q, List.mem_cons_of_mem _ hq, p, hp, hkey⟩

/-- **Tabled**: the state's key is stored in the table. -/
def Tabled (st : State) : Prop :=
  ∃ q ∈ distTab, ∃ p ∈ q.2, skey p.1 = skey st

theorem tabled_of_D_lt {st : State} (h : D st < 999) : Tabled st := by
  obtain ⟨q, hq, p, hp, hkey⟩ := dlookupB_lt distTab h
  exact ⟨q, hq, p, hp, hkey⟩

theorem certOK_of_tabled {st : State} (h : Tabled st) : certOK st = true := by
  obtain ⟨q, hq, p, hp, hkey⟩ := h
  have hmem : p.1 ∈ distTab.flatMap (fun b => b.2.map (fun p => p.1)) :=
    List.mem_flatMap.mpr ⟨q, hq, List.mem_map.mpr ⟨p, hp, rfl⟩⟩
  have h1 := List.all_eq_true.mp cert_all p.1 hmem
  rw [← skey_inj hkey]
  exact h1

/-! ## §4. The induction -/

/-- **THE PLAY BOUND.**  Along any witness play from a tabled state, `D` drops
by at most one per letter, and every visited state stays tabled. -/
theorem play_bound : ∀ {x v : State} {ρ : List Move},
    ShufflePlayW x ρ v → x.WF → Tabled x →
    D x ≤ D v + ρ.length ∧ Tabled v := by
  intro x v ρ hplay
  induction hplay with
  | nil => intro _ hxt; exact ⟨by omega, hxt⟩
  | @cons x t v m rest hrev hstep hrest ih =>
      intro hxwf hxt
      have htwf := step_wf hxwf hstep
      have hrev' : reversibleOf x m = true :=
        (reversibleOf_iff_reversibleAtW hxwf m).mpr hrev
      obtain ⟨hD, hcp⟩ := cert_step (certOK_of_tabled hxt) hrev' hstep
      obtain ⟨hb, hvt⟩ := ih htwf (tabled_of_D_lt hD)
      refine ⟨?_, hvt⟩
      have hl : (m :: rest).length = rest.length + 1 := rfl
      omega

/-! ## §5. The bound -/

theorem D_u : D u = 17 := by decide
theorem D_v : D v = 0 := by decide

theorem u_tabled : Tabled u := tabled_of_D_lt (by rw [D_u]; decide)

/-- **THE 17-LETTER WITNESS IS UNIT-SHORTEST.**  Every witness play `u → v` has
length at least 17. -/
theorem play_shortest (ρ' : List Move) (h' : ShufflePlayW u ρ' v) :
    17 ≤ ρ'.length := by
  obtain ⟨hb, -⟩ := play_bound h' u_wf u_tabled
  rw [D_u, D_v] at hb
  omega

/-! ## §6. THE REFUTATIONS -/

/-- **`CrossSuit.CrossSuitCorridorResidual` IS FALSE.** -/
theorem not_crossSuitCorridorResidual : ¬ CrossSuit.CrossSuitCorridorResidual :=
  corridorResidual_false_of_min play_shortest

/-- **`CrossSuit.CrossSuitPureCorridorResidual` IS FALSE.** -/
theorem not_crossSuitPureCorridorResidual :
    ¬ CrossSuit.CrossSuitPureCorridorResidual :=
  pureResidual_false_of_min play_shortest

/-- **THE TARGET PROPOSITION IS FALSE** (the exact statement, not the
implication from the residual). -/
theorem not_crossSuitVacuityTarget : ¬ CrossSuitVacuityTarget :=
  vacuityTarget_false_of_min play_shortest

