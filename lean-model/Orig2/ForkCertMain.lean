/-! ## §1. The assembly -/

theorem all_flatMap {α β : Type} (p : α → Bool) (f : β → List α) : ∀ l : List β,
    (l.flatMap f).all p = l.all (fun x => (f x).all p)
  | [] => rfl
  | x :: xs => by
      rw [List.flatMap_cons, List.all_append, List.all_cons, all_flatMap p f xs]

/-- **EVERY COMPONENT STATE IS CERTIFIED.**  Assembled from the chunk decides by
pure list/Bool rewriting; each chunk is a small bounded computation.  The
`Bool.true_and`/`Bool.and_true` lemmas collapse the `true && … && true` chain
the append-rewrites leave behind. -/
