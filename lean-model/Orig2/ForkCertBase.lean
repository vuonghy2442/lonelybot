/-- The distance of a state to `v` (`999` = outside the component). -/
def D (st : State) : Nat := dlookupB (rvec st) (skey st) distTab

/-- One state's per-move certificate (the state's own distance is HOISTED). -/
def moveOK (ds : Nat) (st : State) (m : Move) : Bool :=
  if reversibleOf st m then
    match State.step st m with
    | none => true
    | some t =>
        let dt := D t
        decide (dt < 999) && decide (ds ≤ dt + 1)
  else true

/-- One state's certificate. -/
def certOK (st : State) : Bool := (allMoves st).all (moveOK (D st) st)

end Cert
